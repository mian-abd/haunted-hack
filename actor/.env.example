# actor/.env is read by the terse CLI (terse actor dev / terse deploy). Nothing here is required for local dev.
# Keep it to TERSE_* names: `terse deploy` offers to upload every other variable in this file as a cloud secret.

# Local dev server overrides (defaults: port 7100, no auth)
# TERSE_ACTOR_PORT=7100
# TERSE_ACTOR_SECRET=change-me   # then callers must send TERSE_API_KEY=change-me

# For `terse deploy` without `terse auth login`
# TERSE_API_KEY=your-terse-api-key

# The services that CALL the actor (server/, care-team/) set these in THEIR .env, not here:
# TERSE_ACTOR_URL=https://api.useterse.ai/YOUR_PROJECT_ID/actors   # printed by terse deploy; unset = local http://127.0.0.1:7100/v1/projects/local/actors
# TERSE_API_KEY=your-terse-api-key                                  # cloud only
