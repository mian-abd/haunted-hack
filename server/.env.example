# server/ (Bun, :8787). Copy to server/.env (git-ignored) and fill in. Never commit real keys.
# Bun loads .env from the folder you run it in, so start the server from server/.

# Mints browser ephemeral keys for OpenAI Realtime. Empty = /api/realtime-token answers 503 { mock: true }.
OPENAI_API_KEY=

# care-team/ service that receives POST /escalate.
CARE_TEAM_URL=http://localhost:8788

# Optional call archive. Both empty = skip archiving.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Terse generated client. Unset = local `terse actor dev` (http://127.0.0.1:7100/v1/projects/local/actors).
# TERSE_ACTOR_URL=https://api.useterse.ai/YOUR_PROJECT_ID/actors
# TERSE_API_KEY=your-terse-api-key

# 1 = use the in-memory fake ElderActor instead of Terse (also used automatically when server/generated/ is missing).
TERSE_FAKE=

# Port override (default 8787), for testing next to another running server.
# PORT=8787

# Phone check-in through ElevenLabs + Twilio (see README "Phone check-in"). All unset = /api/call/dial answers 503.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ElevenLabs id of our Twilio number (phnum_...), from `elevenlabs agents phone-numbers list`.
ELEVENLABS_PHONE_NUMBER_ID=
# The phone that rings, in E.164 (+1...). Personal data: never commit it.
ELDER_PHONE=
# Any long random string; the agent's webhook tools send it as x-unc-secret. bun run el:setup stores it in ElevenLabs.
EL_TOOL_SECRET=
# Secret of the optional post-call webhook (ElevenLabs dashboard). Unset = /api/el/post-call answers 503.
ELEVENLABS_WEBHOOK_SECRET=
# 1 = ring the phone when the actor's alarm makes a check-in due.
AUTO_DIAL=
# Elder for AUTO_DIAL and for tool webhooks without elder_id.
# ELDER_ID=grandpa-joe

# After every phone call, a recap text to the person on the call (src/sms.ts). All three unset = no texts.
# US carriers block texts from unregistered long-code numbers (Twilio error 30034): register the number for A2P 10DLC,
# or use a toll-free number. A trial account can text only verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Our Twilio number (E.164), the same one ElevenLabs calls from.
TWILIO_FROM=
