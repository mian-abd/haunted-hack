# Nothing in supabase/ reads these. server/ and care-team/ do, server-side only (copy into their .env).
# Leave SUPABASE_URL unset and the services fall back to supabase/seed.json.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (legacy service_role JWT or new sb_secret_ key). It bypasses RLS:
# never put it in web/, in a VITE_ variable, or in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
