# care-team (Bun, :8788). Copy to .env (git-ignored); Bun loads it automatically.
PORT=8788

# Agent brains. Leave OPENAI_API_KEY empty for MOCK mode (deterministic replies that play the demo storyline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Agent Relay (hosted Relaycast API). No login needed: with no key, each start creates a fresh 24h workspace.
# Set RELAY_WORKSPACE_KEY (an ar_ws_... key) to reuse one workspace across restarts.
RELAY_BASE_URL=https://armadillo.agentrelay.com
RELAY_WORKSPACE_KEY=
# RELAY_MODE=local switches to the LOCAL FALLBACK in-process bus (offline testing only, not Agent Relay).
RELAY_MODE=

# Hospital records. Empty means read ../supabase/seed.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElderActor (../actor, terse actor dev on :7100). Local dev needs no URL or key.
# TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
# TERSE_API_KEY=
# TERSE_FAKE=1 forces the in-memory fake actor.
TERSE_FAKE=

# Seconds until the recheck call the doctor asks for (demo default 120).
RECHECK_SECONDS=120
