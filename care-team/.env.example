# care-team/ (Bun, :8788). Copy to .env and fill in. Never commit .env.
PORT=8788

# LLM for the doctor / pharmacy / family turns. Empty = scripted mock mode (same storyline, no API calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=8000

# Agent Relay (hosted). Get a workspace key: npx -y agent-relay@next init --hosted
# Empty = in-process relay for offline dev only; /health warns. The demo needs a real key.
RELAY_WORKSPACE_KEY=
# RELAY_BASE_URL=            # optional, defaults to the hosted service
# RELAY_TOKEN_FILE=.relay-agents.json   # agent tokens saved here (git-ignored)

# ElderActor client: auto | terse | console
# auto = use care-team/generated/ (from `terse actor generate`) when it exists, else print calls to the console
ACTOR_MODE=auto
# TERSE_ACTOR_URL=           # only for deployed actors; local dev defaults to :7100
# TERSE_API_KEY=

# Hospital records. Without Supabase, reads ../supabase/seed.json (then a built-in demo record).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SEED_PATH=../supabase/seed.json

# Demo pacing
DEMO_RECHECK_SECONDS=90
URGENT_RECHECK_SECONDS=60
STEP_DELAY_MS=1200
DISPLAY_TZ=America/Los_Angeles
