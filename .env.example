# Copy to .env (git-ignored) and fill in. ./dev.sh loads it for every service. Never commit real keys.
# Every value is optional: with nothing set, the demo runs in mock / scripted mode.

# OpenAI: server/ mints Realtime voice keys with it, care-team/ runs the agent brains with it.
OPENAI_API_KEY=
# Care-team brains (defaults shown). Some models (gpt-6.1-sol) need OPENAI_REASONING_EFFORT=low.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Agent Relay (care-team/). Empty key = a fresh anonymous 24 h workspace on every start (no login).
RELAY_BASE_URL=https://armadillo.agentrelay.com
RELAY_WORKSPACE_KEY=
# local = offline in-process bus for testing. That traffic is NOT Agent Relay.
RELAY_MODE=

# Supabase (server/ call archive, care-team/ hospital records). Empty = read supabase/seed.json and skip the archive.
# The key is the legacy service_role JWT or a new sb_secret_ key; server-side only, never in web/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Terse actor. Empty = local `terse actor dev` on :7100. Set both only for Terse cloud (see actor/README.md).
TERSE_ACTOR_URL=
TERSE_API_KEY=
# 1 = in-memory fake actor in server/ and care-team/ (no websocket, no persistence).
TERSE_FAKE=

# Phone check-in (ElevenLabs + Twilio): put those variables in server/.env, not here, so `bun run el:setup` sees them
# too. See server/.env.example and README "3. The phone call".

# Wiring and demo timing (defaults shown). Do not set PORT here: every service would try to bind it.
CARE_TEAM_URL=http://localhost:8788
RECHECK_SECONDS=120
VITE_SERVER_URL=http://localhost:8787
